# Copy to .env (gitignored) or set as user environment variables. Never commit real values.

# TypeSafe Jev API key (https://console.typesafe.ai/keys, $5 free credit with Google login).
TYPESAFE_API_KEY=
# Cloudflare Workers AI Clef (Jev-compatible, free 10k Neurons/day): account ID + Workers AI API token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# clef | clef-flash (default clef-flash)
CLEF_MODEL=
# OpenAI Decisions API (paid). For Azure OpenAI use AZURE_OPENAI_API_KEY and OPENAI_BASE_URL=https://<res>.openai.azure.com/openai/v1
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
OPENAI_BASE_URL=
# Model or Azure deployment name (default gpt-6-luna)
OPENAI_DECISIONS_MODEL=
# Slow LLM baseline: Gemini API key from https://aistudio.google.com/apikey (Google login, no card).
GEMINI_API_KEY=
# Gemini model (default gemini-3.6-flash)
GEMINI_MODEL=
# Comma-separated models to try when the main one is overloaded or rate-limited (default gemini-3.5-flash-lite)
GEMINI_FALLBACK_MODELS=
# Per-call timeout in ms (default 60000)
GEMINI_TIMEOUT_MS=
# Min ms between Gemini calls (default 4000, about 15 requests/min for the free tier)
GEMINI_MIN_INTERVAL_MS=
# Optional Gemini thinkingLevel: minimal | low | medium | high
GEMINI_THINKING=
# auto (jev → openai → clef → gemini → mock) | jev | openai | clef | gemini | mock | solver
JEV_DECIDER=auto
# Optional Jev model override
JEV_MODEL=
# Folder produced by `npm run levels -- <game.xapk>`
JEV_LEVELS_DIR=./levels
# Where JSONL run logs go (default ./logs)
JEV_LOG_DIR=./logs
# adb target for --device runs and the live game stream
ANDROID_SERIAL=emulator-5554
# Live game stream: max video dimension (default 720); optional path to your own scrcpy-server
STREAM_MAX_SIZE=
SCRCPY_SERVER=
# Bridge / viewer port
PORT=5173
