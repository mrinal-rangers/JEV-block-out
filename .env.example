# Copy to .env (gitignored) or set as user environment variables. Never commit real values.

# TypeSafe Jev API key (https://console.typesafe.ai/keys). Without it the "auto" decider uses the mock.
TYPESAFE_API_KEY=
# Free alternative: Gemini API key from https://aistudio.google.com/apikey (Google login, no card).
# auto picks gemini when this is set and TYPESAFE_API_KEY is not.
GEMINI_API_KEY=
# Gemini model (default gemini-3.6-flash)
GEMINI_MODEL=
# Comma-separated models to try when the main one is overloaded or rate-limited (default gemini-3.5-flash-lite)
GEMINI_FALLBACK_MODELS=
# Per-call timeout in ms (default 60000)
GEMINI_TIMEOUT_MS=
# Min ms between Gemini calls (default 4000, about 15 requests/min for the free tier)
GEMINI_MIN_INTERVAL_MS=
# Optional Gemini thinkingLevel: minimal | low | medium | high
GEMINI_THINKING=
# auto | jev | gemini | mock | solver
JEV_DECIDER=auto
# Optional Jev model override
JEV_MODEL=
# Folder produced by `npm run levels -- <game.xapk>`
JEV_LEVELS_DIR=./levels
# Where JSONL run logs go (default ./logs)
JEV_LOG_DIR=./logs
# adb target for --device runs
ANDROID_SERIAL=emulator-5554
# Bridge / viewer port
PORT=5173
