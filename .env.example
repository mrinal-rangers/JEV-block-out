# Copy to .env (gitignored) or set as user environment variables. Never commit real values.

# TypeSafe Jev API key (https://console.typesafe.ai/keys). Without it the "auto" decider uses the mock.
TYPESAFE_API_KEY=
# auto | jev | mock | solver
JEV_DECIDER=auto
# Optional Jev model override
JEV_MODEL=
# Folder produced by `npm run levels -- <game.xapk>`
JEV_LEVELS_DIR=./levels
# Where JSONL run logs go (default ./logs)
JEV_LOG_DIR=./logs
# adb target for --device runs
ANDROID_SERIAL=emulator-5554
# Bridge / viewer port
PORT=5173
